<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DD Regression Suite" verbose="1" data-provider-thread-count="5">


    <listeners>
        <listener class-name="com.saurabh.framework.listeners.TestListener"/>
        <listener class-name="com.saurabh.framework.listeners.RetryTransformer"/>
    </listeners>

    <!-- To run in parallel: add parallel="tests" thread-count="2" to <suite> and define more <test> blocks -->
    <test name="Login Tests - Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.saurabh.tests.LoginTest"/>
        </classes>
    </test>
</suite>
